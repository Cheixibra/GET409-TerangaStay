# Copy to .env.local for local overrides. Public Firebase web config only:
# these values end up in the client bundle. Never put a secret here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Set to "true" to talk to the local Functions emulator.
VITE_USE_EMULATOR=
